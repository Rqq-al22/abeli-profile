# ============================================================
# .gitignore - Kelurahan Abeli Admin Panel
# ============================================================

# --- Environment Variables & Secrets (JANGAN pernah di-commit!) ---
.env
.env.local
.env.development
.env.production
.env.staging
*.env

# --- Node.js Dependencies ---
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
package-lock.json
yarn.lock

# --- Local Database File ---
# db.json (disimpan di git untuk seed data Vercel)

# --- Log Files ---
logs/
*.log

# --- OS Files ---
.DS_Store
Thumbs.db
desktop.ini

# --- Editor & IDE ---
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# --- Build Output ---
dist/
build/
.cache/

# --- Temporary Files ---
tmp/
temp/
*.tmp
*.temp

# --- Upload / Media (jika ada) ---
uploads/
public/uploads/
